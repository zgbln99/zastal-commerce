# Core
ZASTAL_HOST=127.0.0.1
ZASTAL_PORT=8880
ZASTAL_DB=./zastal.sqlite3
ZASTAL_ADMIN_TOKEN=replace-with-long-random-token
ZASTAL_SITE_ORIGIN=https://zastalstore.51-15-21-164.sslip.io
# Extra origins only for staging/E2E hosts, comma separated. Leave empty in production.
ZASTAL_ALLOWED_ORIGINS=

# Sales mode: "prelaunch" (default, checkout returns 503) or "live".
# Live checkout opens only when this is "live" AND every readiness check in the panel passes.
ZASTAL_SALES_MODE=prelaunch

# Transactional email; put real values in protected runtime environment only.
ZASTAL_SMTP_HOST=
ZASTAL_SMTP_PORT=587
ZASTAL_SMTP_FROM=
ZASTAL_SMTP_TLS=starttls
# For a loopback-only local capture inbox, TLS=none is accepted with host 127.0.0.1.
ZASTAL_SMTP_USERNAME=
ZASTAL_SMTP_PASSWORD=

# PayU (REST API v2.1). Sandbox credentials from the PayU test panel, production from the signed contract.
ZASTAL_PAYU_ENV=sandbox
ZASTAL_PAYU_POS_ID=
ZASTAL_PAYU_CLIENT_ID=
ZASTAL_PAYU_CLIENT_SECRET=
ZASTAL_PAYU_SECOND_KEY=

# DPD InfoServices object SOAP tracking. Obtain dedicated login/password and
# permissions from DPD; keep real values only in the protected runtime environment.
# The official endpoint is fixed in commerce_dpd.py. No browser-visible settings.
ZASTAL_DPD_LOGIN=
ZASTAL_DPD_PASSWORD=
# Optional channel assigned by DPD (getEventsForWaybillV1 does not require a channel).
ZASTAL_DPD_CHANNEL=
