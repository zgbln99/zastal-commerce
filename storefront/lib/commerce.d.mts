import type { CatalogItem } from './catalog';
export type Personalization = { mode: 'player'; player_id: number } | { mode: 'custom'; name: string; number: string };
export type PrintDisplay = { name: string; number: string; fee?: number };
export type Player = { id: number; name: string; print_name: string; number: string };
export type CartLine = { id: number; size: string; quantity: number; personalization?: Personalization; personalization_display?: PrintDisplay };
export type Variant = { id: number; product_id: number; size: string; sku: string; ean: string; stock: number };
export type Product = CatalogItem & { variants: Variant[]; verified: boolean; personalization_enabled?: boolean; personalization_required?: boolean; personalization_fee?: number };
export type OrderPrint = { mode: 'player' | 'custom'; player_id?: number; name: string; number: string };
export type Filters = { category?: string; query?: string; minPrice?: number; maxPrice?: number; size?: string; available?: boolean; sort?: string };
export const FREE_SHIPPING: number;
export function shippingCost(method: string, subtotal: number): number;
export function normalizeCart(raw: unknown, products?: CatalogItem[]): CartLine[];
export function normalizePersonalization(value: unknown): Personalization | null | undefined;
export function cartLineKey(line: Pick<CartLine, 'id' | 'size' | 'personalization'>): string;
export function variantCartQuantity(cart: CartLine[], id: number, size: string): number;
export function lineUnitPrice(product: Product | undefined, line: Pick<CartLine, 'personalization'>): number;
export function productDisplayPrice(product: Pick<Product, 'price' | 'personalization_required' | 'personalization_fee'>): number;
export function personalizationLabel(line: { personalization?: Personalization | OrderPrint | null; personalization_display?: PrintDisplay }, players?: Player[]): string;
export function extendCartLine(cart: CartLine[], line: CartLine, products: Product[]): CartLine[] | null;
export function updateCartLine(cart: CartLine[], id: number, size: string, quantity: number, personalization?: Personalization, products?: Product[]): CartLine[];
export function mergeCatalog(rows: unknown, fallback?: CatalogItem[]): Product[];
export function normalizeFavorites(raw: unknown, products?: CatalogItem[]): number[];
export function availableQty(product: Product | undefined, size: string): number;
export function canCheckout(cart: CartLine[], products: Product[], players?: Player[]): boolean;
export function filterProducts(products: Product[], filters?: Filters): Product[];
export function removePurchased(cart: CartLine[], submitted: CartLine[]): CartLine[];
