[Unit]
Description=Zastal Store maintenance (unpaid order expiry, session cleanup)
After=zastal-store-api.service

[Service]
Type=oneshot
User=sentinelx
WorkingDirectory=/var/lib/sentinelx/uploads/zastal-commerce-app
EnvironmentFile=/var/lib/sentinelx/uploads/zastal-commerce-app/.runtime.env
ExecStart=/usr/bin/python3 tools/maintenance.py
